ECOM_ENVIRONMENT=development
ECOM_DEBUG=true
ECOM_LOG_LEVEL=INFO
ECOM_API_HOST=127.0.0.1
ECOM_API_PORT=8000
ECOM_READINESS_CHECKS_ENABLED=true
ECOM_READINESS_OUTBOX_LAG_SECONDS=120

MYSQL_DATABASE=ecom_ai
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_APP_USER=ecom_app
MYSQL_APP_PASSWORD=local-app-change-me
MYSQL_HOST_PORT=13306
ECOM_MYSQL_DSN=mysql+asyncmy://ecom_app:local-app-change-me@127.0.0.1:13306/ecom_ai?charset=utf8mb4

POSTGRES_DB=ecom_ai_ai
POSTGRES_USER=ecom_ai
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_HOST_PORT=15432
ECOM_POSTGRES_DSN=postgresql+asyncpg://ecom_ai:local-postgres-change-me@127.0.0.1:15432/ecom_ai_ai
# Optional OpenAI-compatible embeddings endpoint. When omitted, RAG safely falls back to keywords.
ECOM_EMBEDDING_API_URL=
ECOM_EMBEDDING_API_KEY=
ECOM_EMBEDDING_MODEL=ecom-multilingual-v1
ECOM_EMBEDDING_DIMENSION=1536
ECOM_EMBEDDING_TIMEOUT_SECONDS=10

# Optional OpenAI-compatible structured planner. Local development falls back
# to the deterministic planner when all three values are empty.
ECOM_AGENT_MODEL_REQUIRED=false
ECOM_AGENT_MODEL_API_URL=
ECOM_AGENT_MODEL_API_KEY=
ECOM_AGENT_MODEL_NAME=
ECOM_AGENT_MODEL_TEMPERATURE=0
ECOM_AGENT_MODEL_TIMEOUT_SECONDS=30
ECOM_AGENT_PROVIDER_HEALTH_INTERVAL_SECONDS=1800

REDIS_PASSWORD=local-redis-change-me
REDIS_HOST_PORT=16379
ECOM_REDIS_URL=redis://:local-redis-change-me@127.0.0.1:16379/0

# Development-only authentication values. Replace all secrets outside local development.
ECOM_ACCESS_TOKEN_SECRET=development-access-token-secret-change-me
ECOM_SECURITY_HMAC_SECRET=development-hmac-secret-change-me
ECOM_FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ECOM_ACCESS_TOKEN_TTL_SECONDS=900
ECOM_REFRESH_TOKEN_TTL_DAYS=30
ECOM_ADMIN_REFRESH_TOKEN_TTL_HOURS=8
ECOM_REFRESH_COOKIE_SECURE=false
ECOM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
ECOM_DEBUG_VERIFICATION_CODE=000000

ECOM_OBJECT_STORAGE_ENABLED=false
ECOM_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
ECOM_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:19000
ECOM_OBJECT_STORAGE_ACCESS_KEY=local-minio-admin
ECOM_OBJECT_STORAGE_SECRET_KEY=local-minio-change-me
ECOM_OBJECT_STORAGE_REGION=us-east-1
# Empty for normal development. Integration tests must use a test-only prefix.
ECOM_OBJECT_STORAGE_BUCKET_PREFIX=
ECOM_OBJECT_STORAGE_PRESIGN_SECONDS=600
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
ECOM_FILE_SCANNER_ENABLED=false
ECOM_FILE_SCANNER_HOST=127.0.0.1
ECOM_FILE_SCANNER_PORT=13310
ECOM_FILE_SCANNER_TIMEOUT_SECONDS=30
ECOM_FILE_RECONCILIATION_INTERVAL_SECONDS=3600
ECOM_FILE_RECONCILIATION_MAX_OBJECTS=100000
ECOM_FILE_ORPHAN_GRACE_DAYS=14
ECOM_FILE_UNREFERENCED_GRACE_DAYS=7
ECOM_FILE_GC_INTERVAL_SECONDS=300
ECOM_FILE_GC_BATCH_SIZE=100
ECOM_LIFECYCLE_POLL_SECONDS=60
ECOM_LIFECYCLE_BATCH_SIZE=200
ECOM_CHECKOUT_RETENTION_DAYS=30
CLAMAV_HOST_PORT=13310

ECOM_ORDER_TIMEOUT_POLL_SECONDS=2
ECOM_ORDER_TIMEOUT_BATCH_SIZE=100
ECOM_ORDER_AUTO_CONFIRM_DAYS=7
ECOM_PAYMENT_RECONCILE_POLL_SECONDS=2
ECOM_PAYMENT_RECONCILE_BATCH_SIZE=100
ECOM_LOGISTICS_SYNC_POLL_SECONDS=0.5
ECOM_LOGISTICS_SYNC_STALE_SECONDS=300
ECOM_LOGISTICS_SYNC_BATCH_SIZE=100
ECOM_REVIEW_SUBMISSION_WINDOW_DAYS=30
ECOM_REVIEW_EDIT_WINDOW_HOURS=24
ECOM_REVIEW_APPEND_WINDOW_DAYS=180
ECOM_REFUND_DUAL_APPROVAL_THRESHOLD_MINOR=50000
ECOM_ADMIN_APPROVAL_TTL_MINUTES=30
ECOM_ADMIN_APPROVAL_WORKER_POLL_SECONDS=2

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
