# Copy outside version control as .env.production and obtain every secret from
# the deployment secret manager. Values below are intentionally non-functional.
ECOM_API_IMAGE=ghcr.io/szlstart/ecom-ai-api@sha256:<64-hex-digest>
ECOM_FRONTEND_IMAGE=ghcr.io/szlstart/ecom-ai-frontend@sha256:<64-hex-digest>
ECOM_PUBLIC_ORIGIN=https://shop.example.com
ECOM_ALLOWED_ORIGINS=https://shop.example.com
ECOM_TRUSTED_PROXY_CIDRS=10.20.0.0/24
ECOM_METRICS_ALLOWED_CIDRS=10.30.0.0/24
ECOM_MYSQL_DSN=mysql+asyncmy://<user>:<secret>@<private-host>:3306/ecom_ai?charset=utf8mb4&ssl=true
ECOM_POSTGRES_DSN=postgresql+asyncpg://<user>:<secret>@<private-host>:5432/ecom_ai_ai?ssl=require
# 仅注入一次性迁移 Job；API/Worker 不得获得以下 DDL 凭证。
ECOM_MYSQL_MIGRATION_DSN=mysql+asyncmy://<migration-user>:<secret>@<private-host>:3306/ecom_ai?charset=utf8mb4&ssl=true
ECOM_POSTGRES_MIGRATION_DSN=postgresql+asyncpg://<migration-user>:<secret>@<private-host>:5432/ecom_ai_ai?ssl=require
ECOM_REDIS_URL=rediss://:<secret>@<private-host>:6379/0
ECOM_AGENT_MODEL_API_URL=https://model-gateway.private.example.com/v1
ECOM_AGENT_MODEL_API_KEY=<secret-manager-reference>
ECOM_AGENT_MODEL_NAME=<approved-model-deployment>
ECOM_AGENT_MODEL_WIRE_API=responses
ECOM_AGENT_MODEL_TEMPERATURE=0.2
ECOM_AGENT_MODEL_TIMEOUT_SECONDS=60
ECOM_MYSQL_POOL_SIZE=10
ECOM_MYSQL_MAX_OVERFLOW=10
ECOM_MYSQL_POOL_TIMEOUT_SECONDS=10
ECOM_POSTGRES_POOL_SIZE=5
ECOM_POSTGRES_MAX_OVERFLOW=5
ECOM_POSTGRES_POOL_TIMEOUT_SECONDS=10
ECOM_REDIS_MAX_CONNECTIONS=20
ECOM_ORDER_AUTO_CONFIRM_DAYS=7
ECOM_ACCESS_TOKEN_SECRET=<at-least-32-random-characters>
ECOM_SECURITY_HMAC_SECRET=<at-least-32-random-characters>
ECOM_FIELD_ENCRYPTION_KEY=<versioned-base64-key>
ECOM_OBJECT_STORAGE_ENDPOINT=https://object-storage.private.example.com
ECOM_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://cdn.example.com
ECOM_OBJECT_STORAGE_ACCESS_KEY=<secret-manager-reference>
ECOM_OBJECT_STORAGE_SECRET_KEY=<secret-manager-reference>
ECOM_OBJECT_STORAGE_BUCKET_PREFIX=
ECOM_FILE_SCANNER_HOST=clamav.private.example.com
ECOM_FILE_SCANNER_PORT=3310
ECOM_FILE_RECONCILIATION_INTERVAL_SECONDS=3600
ECOM_FILE_RECONCILIATION_MAX_OBJECTS=100000
ECOM_FILE_ORPHAN_GRACE_DAYS=14
ECOM_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.private.example.com:4317
ECOM_REFRESH_COOKIE_SECURE=true
ECOM_ADMIN_PASSWORD_LOGIN_ENABLED=false
